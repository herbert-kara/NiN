<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- The active-row highlight is a WPF contract: the test builds a real
             DataGridRow and a real style so the trigger is evaluated, not grepped. -->
        <UseWPF>true</UseWPF>
        <TargetFramework>net10.0-windows</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" />
        <PackageReference Include="TUnit.Assertions.Should" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ServiceLib\ServiceLib.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="TUnit.Assertions.Should" />
        <Using Include="TUnit.Assertions.Should.Extensions" />
    </ItemGroup>

</Project>
