<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- The active-row highlight is a WPF contract: these tests build a real
             DataGridRow and a real style so the trigger is evaluated, not grepped.
             UseWPF swaps out the default implicit-using set, so the ones the other
             tests rely on are listed back in explicitly. -->
        <UseWPF>true</UseWPF>
        <TargetFramework>net10.0-windows</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="System.Net.Http" />
        <Using Include="System.IO" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" />
        <PackageReference Include="TUnit.Assertions.Should" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ServiceLib\ServiceLib.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="TUnit.Assertions.Should" />
        <Using Include="TUnit.Assertions.Should.Extensions" />
    </ItemGroup>

</Project>
